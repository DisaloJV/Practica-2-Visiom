import os
import cv2
import numpy as np
import matplotlib.pyplot as plt

CARPETA = os.path.dirname(os.path.abspath(__file__))

def buscar_imagen(carpeta):
   
    exts = (".png", ".jpg", ".jpeg", ".bmp", ".webp")
    archivos = os.listdir(carpeta)
    print("Archivos en la carpeta:", archivos)
    imgs = [f for f in archivos
            if f.lower().endswith(exts) and not f[0].isdigit()]
    if not imgs:
        raise FileNotFoundError("No hay imagenes en: " + carpeta)
    preferidas = [f for f in imgs if "capib" in f.lower()]
    return os.path.join(carpeta, (preferidas or imgs)[0])

RUTA_IMG = buscar_imagen(CARPETA)
print("Usando imagen:", RUTA_IMG)

datos = np.fromfile(RUTA_IMG, dtype=np.uint8)
img = cv2.imdecode(datos, cv2.IMREAD_COLOR)
if img is None:
    raise FileNotFoundError("No se pudo decodificar la imagen: " + RUTA_IMG)
alto, ancho = img.shape[:2]

x0, y0 = int(0.26 * ancho), int(0.07 * alto)
x1, y1 = int(0.75 * ancho), int(0.97 * alto)
rect = (x0, y0, x1 - x0, y1 - y0)

mascara_gc = np.full((alto, ancho), cv2.GC_BGD, np.uint8)
mascara_gc[y0:y1, x0:x1] = cv2.GC_PR_BGD
cx, cy = (x0 + x1) // 2, int(0.55 * alto)
cv2.ellipse(mascara_gc, (cx, cy), (int(0.21 * ancho), int(0.40 * alto)),
            0, 0, 360, cv2.GC_PR_FGD, -1)
cv2.ellipse(mascara_gc, (cx, cy + 5), (int(0.14 * ancho), int(0.27 * alto)),
            0, 0, 360, cv2.GC_FGD, -1)
bgd = np.zeros((1, 65), np.float64)
fgd = np.zeros((1, 65), np.float64)

cv2.grabCut(img, mascara_gc, None, bgd, fgd, 10, cv2.GC_INIT_WITH_MASK)

mascara = np.where(
    (mascara_gc == cv2.GC_FGD) | (mascara_gc == cv2.GC_PR_FGD), 255, 0
).astype(np.uint8)


k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
mascara = cv2.morphologyEx(mascara, cv2.MORPH_CLOSE, k, iterations=2)
mascara = cv2.morphologyEx(mascara, cv2.MORPH_OPEN, k, iterations=1)


n, etiquetas, stats, _ = cv2.connectedComponentsWithStats(mascara, connectivity=8)
if n > 1:
    mayor = 1 + np.argmax(stats[1:, cv2.CC_STAT_AREA])
    mascara = np.where(etiquetas == mayor, 255, 0).astype(np.uint8)


cont_ext, _ = cv2.findContours(mascara, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)
mascara = np.zeros_like(mascara)
cv2.drawContours(mascara, cont_ext, -1, 255, thickness=cv2.FILLED)


mascara = cv2.GaussianBlur(mascara, (5, 5), 0)
_, mascara = cv2.threshold(mascara, 127, 255, cv2.THRESH_BINARY)


contornos, _ = cv2.findContours(mascara, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)
contorno = max(contornos, key=cv2.contourArea)

img_contorno = img.copy()
cv2.drawContours(img_contorno, [contorno], -1, (0, 255, 0), 2)
bx, by, bw, bh = cv2.boundingRect(contorno)
cv2.rectangle(img_contorno, (bx, by), (bx + bw, by + bh), (0, 0, 255), 1)

segmentado = cv2.bitwise_and(img, img, mask=mascara)

area = cv2.contourArea(contorno)
perimetro = cv2.arcLength(contorno, True)
print("Area del capibara   :", round(area), "px")
print("Perimetro            :", round(perimetro, 1), "px")
print("Bounding box         : x=%d, y=%d, w=%d, h=%d" % (bx, by, bw, bh))
print("Porcentaje de imagen : %.1f %%" % (100 * area / (alto * ancho)))

cv2.imwrite(os.path.join(CARPETA, "1_mascara.png"), mascara)
cv2.imwrite(os.path.join(CARPETA, "2_contorno.png"), img_contorno)
cv2.imwrite(os.path.join(CARPETA, "3_segmentado.png"), segmentado)

rgb = lambda a: cv2.cvtColor(a, cv2.COLOR_BGR2RGB)
fig, ax = plt.subplots(1, 4, figsize=(16, 4))
ax[0].imshow(rgb(img));            ax[0].set_title("Original")
ax[1].imshow(mascara, cmap="gray"); ax[1].set_title("Máscara obtenida")
ax[2].imshow(rgb(img_contorno));   ax[2].set_title("Contorno")
ax[3].imshow(rgb(segmentado));     ax[3].set_title("Segmentación")
for a in ax:
    a.axis("off")
plt.tight_layout()
plt.savefig(os.path.join(CARPETA, "4_resumen.png"), dpi=150)
plt.show()
